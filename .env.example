# ============================================================
#  Nihongo Kizuna — Frontend Environment Variables
#  Sao chép thành .env.local để chạy tại máy.
# ============================================================

# URL của Backend API.
# Biến có tiền tố NEXT_PUBLIC_ sẽ bị nhúng thẳng vào bundle JS gửi xuống trình duyệt
# → TUYỆT ĐỐI không đặt secret vào biến dạng này.
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Địa chỉ chính thức của trang (dùng cho metadata, SEO, canonical URL)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_APP_NAME=Nihongo Kizuna
